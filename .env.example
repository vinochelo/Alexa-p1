# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=AIzaSyDTeKOJvhoZLz_97Vml2U0Qa-mQGQ7tPXI

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OPENROUTER_API_KEY: Required for OpenRouter fallback API calls.
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"

# OPENROUTER_APP_URL: Optional. Used for the HTTP-Referer header in OpenRouter requests.
# If not set, it will fallback to APP_URL or a default value.
OPENROUTER_APP_URL="https://alexa-modo-pro.vercel.app"

# OPENROUTER_APP_TITLE: Optional. Used for the X-Title header in OpenRouter requests.
OPENROUTER_APP_TITLE="Alexa Modo Pro Skill"
